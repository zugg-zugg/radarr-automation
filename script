set -o pipefail

# ====== Configuration ======
QBIT_URL="http://CHANGE_ME:8080"        # same URL/port Radarr uses for the qBittorrent client
QBIT_USER="REDACTED"
QBIT_PASS="REDACTED"
QBIT_CATEGORY="movie-radarr"           # category Radarr assigns (Radarr > Settings > Download Clients)

RCLONE_CONTAINER="binhex-rclone"
RCLONE_CONFIG_PATH="/config/rclone/config/rclone.conf"
RCLONE_REMOTE_NAME="seedbox"
RCLONE_TRANSFERS=4
RCLONE_BWLIMIT=""
RCLONE_EXTRA=()                         # e.g. (--sftp-concurrency 32)

# Seedbox folder that Radarr's remote path mapping points at
REMOTE_ROOT="/home/path/sample/Downloads/bittorrent"

# Local landing folder host path, rclone-container path, Radarr-container path
RADARR_IMPORT_PATH="/mnt/user/media/incoming"
RCLONE_DEST_PATH="/data/incoming"
RADARR_CONTAINER_PATH="/media/incoming"          # how the Radarr container sees the same folder

RADARR_API_KEY="REDACTED"
RADARR_URL="http://localhost:7878"

LOG_FILE="/mnt/user/logs/RADARR_import.log"
STATE_DIR="/mnt/user/appdata/seedbox-pull-radarr"
LEDGER="$STATE_DIR/pulled_hashes.txt"
LOCK_FILE="/tmp/seedbox_pull_radarr.lock"
# ===========================

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE" ; }

mkdir -p "$(dirname "$LOG_FILE")" "$RADARR_IMPORT_PATH" "$STATE_DIR"
touch "$LEDGER"

command -v jq >/dev/null 2>&1 || { log "❌ jq not found."; exit 1; }

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "⏭️ Previous run still active, skipping."
  exit 0
fi

if [[ -f "$LOG_FILE" ]] && [[ $(stat -c %s "$LOG_FILE") -gt 10485760 ]]; then
  mv -f "$LOG_FILE" "$LOG_FILE.1"
fi

COOKIE="$(mktemp)"
trap 'rm -f "$COOKIE"' EXIT

# ---- qBittorrent login ----
LOGIN=$(curl -s -c "$COOKIE" -H "Referer: $QBIT_URL" \
  --data-urlencode "username=$QBIT_USER" --data-urlencode "password=$QBIT_PASS" \
  "$QBIT_URL/api/v2/auth/login")
if [[ "$LOGIN" != Ok* ]]; then
  log "❌ qBittorrent login failed (response: $LOGIN)"
  exit 1
fi

qb() { curl -s -b "$COOKIE" -H "Referer: $QBIT_URL" "$@"; }

TORRENTS=$(qb -G --data-urlencode "category=$QBIT_CATEGORY" --data-urlencode "filter=completed" \
  "$QBIT_URL/api/v2/torrents/info")
if ! echo "$TORRENTS" | jq -e 'type=="array"' >/dev/null 2>&1; then
  log "❌ Unexpected response from qBittorrent torrents/info"
  exit 1
fi

# ---- Bootstrap: mark everything currently complete as already handled ----
if [[ "$1" == "--bootstrap" ]]; then
  echo "$TORRENTS" | jq -r '.[] | select(.progress==1) | .hash' >> "$LEDGER"
  sort -u "$LEDGER" -o "$LEDGER"
  log "Bootstrap complete: $(wc -l < "$LEDGER") hashes recorded."
  exit 0
fi

extract_dir() {
  # Extract RAR sets under $1, clean up only after media is confirmed
  local root="$1" extractor=""
  if command -v unrar >/dev/null 2>&1; then extractor="unrar"
  elif command -v 7z >/dev/null 2>&1; then extractor="7z"
  else log "❌ No extractor (unrar/7z); skipping extraction."; return 0; fi

  find "$root" -type f \
    \( -iname '*.part01.rar' -o -iname '*.part1.rar' -o \( -iname '*.rar' ! -iname '*.part*.rar' \) \) \
    | while read -r rarfile; do
      local d; d="$(dirname "$rarfile")"
      log "📦 Extracting: $rarfile"
      if [[ "$extractor" == "unrar" ]]; then
        unrar x -o+ -y "$rarfile" "$d/" >> "$LOG_FILE" 2>&1 </dev/null
      else
        7z x -y -o"$d" "$rarfile" >> "$LOG_FILE" 2>&1 </dev/null
      fi
      if [[ $? -ne 0 ]]; then log "❌ Extraction failed in $d; keeping archives."; continue; fi

      find "$d" -maxdepth 1 -type f -iname 'sample.*' -delete >> "$LOG_FILE" 2>&1
      if ! find "$d" -maxdepth 1 -type f \
           \( -iname '*.mkv' -o -iname '*.mp4' -o -iname '*.avi' -o -iname '*.mov' \) | grep -q .; then
        log "❌ No media after extraction in $d; skipping archive cleanup."
        continue
      fi
      find "$d" -maxdepth 1 -type f \
        \( -iname '*.rar' -o -regex '.*\.r[0-9][0-9]$' -o -iname '*.rev' \) -delete >> "$LOG_FILE" 2>&1
    done
}

PULLED=0
SCAN_PATHS=()
while IFS=$'\t' read -r hash name save_path; do
  [[ -z "$hash" ]] && continue
  grep -qx "$hash" "$LEDGER" && continue

  save_path="${save_path%/}"
  if [[ "$save_path" != "$REMOTE_ROOT" && "$save_path" != "$REMOTE_ROOT"/* ]]; then
    log "⚠️ Skipping '$name': save path '$save_path' is outside REMOTE_ROOT."
    continue
  fi
  rel="${save_path#"$REMOTE_ROOT"}"          # "" or "/subdir"
  host_dir="$RADARR_IMPORT_PATH$rel"
  cont_dir="$RCLONE_DEST_PATH$rel"
  mkdir -p "$host_dir"

  # Exact file list for this torrent: wanted files only, no samples
  LIST_DIR="$RADARR_IMPORT_PATH/.pull-lists"
  mkdir -p "$LIST_DIR"
  list_host="$LIST_DIR/$hash.txt"
  qb -G --data-urlencode "hash=$hash" "$QBIT_URL/api/v2/torrents/files" \
    | jq -r '.[] | select(.priority>0)
             | select(.name | test("(^|/)sample([/._-]|$)"; "i") | not)
             | .name' > "$list_host"
  if [[ ! -s "$list_host" ]]; then
    log "⚠️ No files listed for '$name'; skipping this run."
    rm -f "$list_host"
    continue
  fi

  log "⬇️ Pulling: $name"
  RARGS=(copy --config="$RCLONE_CONFIG_PATH"
    "$RCLONE_REMOTE_NAME:$save_path" "$cont_dir"
    --files-from-raw "$RCLONE_DEST_PATH/.pull-lists/$hash.txt"
    --transfers="$RCLONE_TRANSFERS" --multi-thread-streams=4
    --retries 3 --low-level-retries 10 --contimeout 30s --timeout 5m
    -v --stats=60s --stats-one-line)
  [[ -n "$RCLONE_BWLIMIT" ]] && RARGS+=(--bwlimit "$RCLONE_BWLIMIT")
  RARGS+=("${RCLONE_EXTRA[@]}")

  if docker exec "$RCLONE_CONTAINER" rclone "${RARGS[@]}" >> "$LOG_FILE" 2>&1 </dev/null; then
    rm -f "$list_host"
    [[ -d "$host_dir/$name" ]] && extract_dir "$host_dir/$name"
    echo "$hash" >> "$LEDGER"
    PULLED=$((PULLED + 1))
    SCAN_PATHS+=("$RADARR_CONTAINER_PATH$rel/$name")
    log "✅ Done: $name"
  else
    log "❌ rclone failed for '$name'; will retry next run."
    rm -f "$list_host"
  fi
done < <(echo "$TORRENTS" | jq -r '.[] | select(.progress==1) | [.hash, .name, .save_path] | @tsv')

# ---- Tell Radarr about each newly pulled item (only if something new arrived) ----
if [[ $PULLED -gt 0 ]]; then
  find "$RADARR_IMPORT_PATH" -mmin -60 -exec chown nobody:users {} + 2>>"$LOG_FILE"
  for scan_path in "${SCAN_PATHS[@]}"; do
    log "Triggering Radarr scan for: $scan_path"
    BODY=$(jq -n --arg p "$scan_path" '{name:"DownloadedMoviesScan", path:$p, importMode:"Move"}')
    RESPONSE=$(curl -s -w "\nHTTP_STATUS_CODE:%{http_code}" -X POST "${RADARR_URL}/api/v3/command" \
      -H "X-Api-Key: ${RADARR_API_KEY}" -H "Content-Type: application/json" -d "$BODY")
    CODE=$(echo "$RESPONSE" | awk -F: '/HTTP_STATUS_CODE/ {print $2}')
    if [[ "$CODE" == "200" || "$CODE" == "201" ]]; then
      log "✅ Radarr scan queued."
    else
      log "❌ Radarr returned HTTP $CODE: $(echo "$RESPONSE" | sed '/HTTP_STATUS_CODE/d')"
    fi
  done
else
  log "Nothing new to pull."
fi